<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist (GENERATE_INFOPLIST_FILE).
	     Declares mailto: so browsers and other apps can hand off compose
	     links, and so we can offer Settings → default email app. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<!-- Expanded at build time so Debug vs Release labels match bundle id. -->
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).mailto</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mailto</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dreamail</string>
			</array>
		</dict>
	</array>
	<!-- In-app update channel (OWNER/REPO). Empty unless the build sets
	     DREAMAIL_UPDATE_CHANNEL (see Config/Signing.xcconfig); empty means the
	     updater is disabled. -->
	<key>DreaMailUpdateChannel</key>
	<string>$(DREAMAIL_UPDATE_CHANNEL)</string>
	<!-- AI features and the local MCP server. Empty unless the build sets
	     DREAMAIL_AI_FEATURES = YES (see Config/Signing.xcconfig); empty means
	     both are off. -->
	<key>DreaMailAIFeatures</key>
	<string>$(DREAMAIL_AI_FEATURES)</string>
	<!-- Google Calendar integration (step 4A). Empty unless the build sets
	     DREAMAIL_CALENDAR = YES (see Config/Signing.xcconfig); empty means off. -->
	<key>DreaMailCalendar</key>
	<string>$(DREAMAIL_CALENDAR)</string>
	<!-- OpenPGP support (step 4B). Empty unless the build sets
	     DREAMAIL_PGP = YES (see Config/Signing.xcconfig); empty means off. -->
	<key>DreaMailPGP</key>
	<string>$(DREAMAIL_PGP)</string>
</dict>
</plist>
